# ============================================
# CSV Bulk Upload Module - Production (Vercel)
# ============================================

# ============================================
# Django API Configuration
# ============================================
NEXT_PUBLIC_DJANGO_API_URL=https://gcp.galactus.run

# ============================================
# AWS S3 Configuration (Server-side ONLY)
# ============================================
AWS_S3_BUCKET=topmate-staging
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-south-1
AWS_REGION_CUSTOM=ap-south-1
S3_BASE_URL=https://topmate-staging.s3.ap-south-1.amazonaws.com

# ============================================
# Base URL - UPDATE THIS AFTER FIRST DEPLOYMENT
# ============================================
# After deploying to Vercel, update this with your actual URL
# Example: https://csv-standalone.vercel.app
NEXT_PUBLIC_BASE_URL=https://your-vercel-url.vercel.app

# ============================================
# AWS Lambda Infrastructure (Optional)
# ============================================
SQS_QUEUE_URL=
DYNAMODB_JOBS_TABLE=

# ============================================
# Next.js Configuration
# ============================================
NODE_ENV=production
DISABLE_IMAGE_OPTIMIZATION=true
