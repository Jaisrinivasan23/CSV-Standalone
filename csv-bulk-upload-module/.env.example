# ============================================
# CSV Bulk Upload Module - Environment Variables
# ============================================
# Copy this file to .env.local for development
# Copy this file to .env.prod for production deployment

# ============================================
# Django API Configuration
# ============================================
NEXT_PUBLIC_DJANGO_API_URL=https://gcp.galactus.run

# ============================================
# AWS S3 Configuration (Server-side ONLY)
# ============================================
# Get these from AWS Console -> IAM -> Users -> Security credentials
AWS_S3_BUCKET=topmate-staging
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=ap-south-1
AWS_REGION_CUSTOM=ap-south-1
S3_BASE_URL=https://topmate-staging.s3.ap-south-1.amazonaws.com

# ============================================
# Base URL (update after deployment)
# ============================================
# Local development
NEXT_PUBLIC_BASE_URL=http://localhost:3001

# Production (update after serverless deploy)
# NEXT_PUBLIC_BASE_URL=https://your-api-id.execute-api.ap-south-1.amazonaws.com

# ============================================
# Lambda Layer Configuration
# ============================================
# Add this after creating Sharp layer
# Format: arn:aws:lambda:ap-south-1:YOUR_ACCOUNT_ID:layer:sharp-chromium-layer:1
SHARP_LAYER_ARN=

# ============================================
# AWS Lambda Infrastructure (Auto-populated)
# ============================================
# These are auto-created by CloudFormation during deployment
# Leave empty for local development
SQS_QUEUE_URL=
DYNAMODB_JOBS_TABLE=

# ============================================
# Next.js Configuration
# ============================================
NODE_ENV=development
DISABLE_IMAGE_OPTIMIZATION=true
